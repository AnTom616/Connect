# ==============================================================
# ConnectHub — Variáveis de ambiente
# ==============================================================

# String de conexão do banco PostgreSQL (recomendado: Neon, via
# integração oficial da Vercel). É a única variável necessária
# para a persistência REAL em produção.
#
# Sem ela: o projeto roda localmente com SQLite (modo desenvolvimento).
# Na Vercel sem ela: a API retorna erro orientando a configuração.
#
# Formato (exemplo do Neon — use a connection string "pooled"):
# DATABASE_URL="postgresql://usuario:senha@ep-nome-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL=
